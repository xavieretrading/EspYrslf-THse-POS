    <style>
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 11px; }
      table { border-collapse: collapse; }
      th { background-color: #4a3728; color: #ffffff; font-weight: bold; text-align: center; border: 1px solid #d2c4b7; padding: 8px; font-size: 12px; }
      td { border: 1px solid #e2d7cd; padding: 6px 8px; vertical-align: middle; }
      .num { text-align: right; mso-number-format: "\#\,\#\#0\.00"; }
      .pct { text-align: right; mso-number-format: "0\.0%"; }
      .category-header { background-color: #8b7355; color: #ffffff; font-weight: bold; font-size: 12px; }
      .row-even { background-color: #faf8f6; }
      .row-odd { background-color: #ffffff; }
      .margin-high { background-color: #e6f4ea; color: #137333; font-weight: bold; text-align: center; }
      .margin-med { background-color: #fef7e0; color: #b06000; font-weight: bold; text-align: center; }
      .margin-low { background-color: #fce8e6; color: #c5221f; font-weight: bold; text-align: center; }
      .title-cell { font-size: 16px; font-weight: bold; color: #4a3728; padding: 12px 0; }
      .desc-cell { font-size: 11px; color: #6e5c4f; padding-bottom: 12px; font-style: italic; }
    </style>
  </head>
