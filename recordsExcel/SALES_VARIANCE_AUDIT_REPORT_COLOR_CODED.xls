
  <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
  <head>
    <meta charset="utf-8" />
    <!--[if gte mso 9]>
    <xml>
      <x:ExcelWorkbook>
        <x:ExcelWorksheets>
          <x:ExcelWorksheet>
            <x:Name>Sales Variance Audit</x:Name>
            <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>
          </x:ExcelWorksheet>
        </x:ExcelWorksheets>
      </x:ExcelWorkbook>
    </xml>
    <![endif]-->
    <style>
      body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 11px; color: #1e293b; margin: 20px; }
      table { border-collapse: collapse; margin-bottom: 24px; width: 100%; }
      th, td { border: 1px solid #cbd5e1; padding: 8px 12px; font-size: 11px; vertical-align: middle; }
      
      .main-title { background: #0f172a; color: #ffffff; font-size: 16px; font-weight: 900; text-align: center; padding: 14px; letter-spacing: 0.5px; }
      .sub-title { background: #0369a1; color: #ffffff; font-size: 11px; font-weight: bold; text-align: center; padding: 7px; }
      
      .kpi-card { background: #f8fafc; border: 2px solid #cbd5e1; text-align: center; padding: 12px; }
      .kpi-val { font-size: 16px; font-weight: 900; font-family: 'Segoe UI', Tahoma, sans-serif; margin-top: 4px; }
      .kpi-lbl { font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; }
      
      .sec-header { background: #1e293b; color: #ffffff; font-size: 12px; font-weight: bold; padding: 10px 12px; text-transform: uppercase; letter-spacing: 0.5px; }
      .tbl-head { background: #f1f5f9; color: #1e293b; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; }
      
      .num { text-align: right; font-family: 'Courier New', monospace; font-weight: 600; }
      .num-bold { text-align: right; font-family: 'Courier New', monospace; font-weight: 900; }
      
      .badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-weight: 800; font-size: 9px; text-align: center; text-transform: uppercase; letter-spacing: 0.5px; }
      .tag-coffee { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-weight: bold; border-radius: 3px; padding: 2px 6px; font-size: 10px; }
      .tag-laundry { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; font-weight: bold; border-radius: 3px; padding: 2px 6px; font-size: 10px; }
      
      .row-total { background: #ecfdf5; color: #065f46; font-weight: 900; font-size: 12px; border-top: 3px solid #059669; border-bottom: 3px solid #059669; }
      .row-highlight { background: #fffbeb; }
    </style>
  </head>
  <body>

    <!-- 1. HEADER BANNER -->
    <table>
      <tr>
        <td colspan="8" class="main-title">☕ ESPRESSO YOURSELF & TEA HOUSE — AUDIT & SALES VARIANCE REPORT 🧺</td>
      </tr>
      <tr>
        <td colspan="8" class="sub-title">PERIOD: JULY 31, 2026 TO AUGUST 13, 2026 | COMPARING: POS SYSTEM DATABASE VS MANUAL BAR RECORDS</td>
      </tr>
      <tr style="background: #f8fafc; font-size: 11px;">
        <td style="font-weight: bold; width: 12%;">Report Period:</td>
        <td style="width: 20%; color: #0369a1; font-weight: bold;">07/31/2026 – 08/13/2026</td>
        <td style="font-weight: bold; width: 12%;">Branch:</td>
        <td style="width: 20%; color: #0f172a; font-weight: bold;">Main Branch (Cebu)</td>
        <td style="font-weight: bold; width: 12%;">Generated At:</td>
        <td colspan="3" style="color: #334155; font-weight: bold;">August 13, 2026</td>
      </tr>
    </table>

    <!-- 2. HIGH-LEVEL KPI DASHBOARD CARDS -->
    <table>
      <tr>
        <td colspan="2" class="kpi-card" style="border-left: 4px solid #059669; background: #ecfdf5;">
          <div class="kpi-lbl" style="color: #065f46;">TOTAL POS GROSS SALES</div>
          <div class="kpi-val" style="color: #047857;">₱27,867.00</div>
          <div style="font-size: 9px; color: #059669; font-weight: 600;">Coffee (₱12.7k) + Laundry (₱15.1k)</div>
        </td>
        <td colspan="2" class="kpi-card" style="border-left: 4px solid #d97706; background: #fffbeb;">
          <div class="kpi-lbl" style="color: #92400e;">☕ COFFEE & FOOD SALES</div>
          <div class="kpi-val" style="color: #b45309;">₱12,706.00</div>
          <div style="font-size: 9px; color: #d97706; font-weight: 600;">Manual Bar Sheet: ₱12,203.00 (+₱633)</div>
        </td>
        <td colspan="2" class="kpi-card" style="border-left: 4px solid #2563eb; background: #eff6ff;">
          <div class="kpi-lbl" style="color: #1e40af;">🧺 LAUNDRY SERVICES SALES</div>
          <div class="kpi-val" style="color: #1d4ed8;">₱15,161.00</div>
          <div style="font-size: 9px; color: #2563eb; font-weight: 600;">S1p & Sp1n Laundry System</div>
        </td>
        <td colspan="2" class="kpi-card" style="border-left: 4px solid #7c3aed; background: #f5f3ff;">
          <div class="kpi-lbl" style="color: #6d28d9;">💵 TOTAL CASH + FLOAT COUNT</div>
          <div class="kpi-val" style="color: #7c3aed;">₱29,867.00</div>
          <div style="font-size: 9px; color: #7c3aed; font-weight: 600;">Includes ₱2,000 Starting Cash Float</div>
        </td>
      </tr>
    </table>

    <!-- 3. EXECUTIVE RECONCILIATION SUMMARY -->
    <table>
      <thead>
        <tr>
          <th colspan="8" class="sec-header">1. EXECUTIVE REVENUE & CASH RECONCILIATION</th>
        </tr>
        <tr class="tbl-head">
          <th colspan="2" style="text-align: left;">Category / Department</th>
          <th style="text-align: right;">Manual Ledger (₱)</th>
          <th style="text-align: right;">POS System Sales (₱)</th>
          <th style="text-align: right;">Variance (₱)</th>
          <th style="text-align: center;">Status</th>
          <th colspan="2" style="text-align: left;">Audit Explanation & Reason</th>
        </tr>
      </thead>
      <tbody>
        <tr style="background: #ffffff;">
          <td colspan="2" style="font-weight: bold; font-size: 11px;">
            <span class="tag-coffee">☕ COFFEE & FOOD</span>
            <span style="margin-left: 8px;">Espresso Yourself & Tea House</span>
          </td>
          <td class="num">₱12,203.00</td>
          <td class="num-bold" style="color: #b45309;">₱12,706.00</td>
          <td class="num-bold" style="color: #059669;">+₱503.00</td>
          <td style="text-align: center;"><span class="badge" style="background: #d1fae5; color: #065f46;">POS +₱633</span></td>
          <td colspan="2" style="color: #334155;">POS captured +₱633 in additional dine-in orders that were rung up but not logged on the paper ledger.</td>
        </tr>

        <tr style="background: #f8fafc;">
          <td colspan="2" style="font-weight: bold; font-size: 11px;">
            <span class="tag-laundry">🧺 LAUNDRY SERVICES</span>
            <span style="margin-left: 8px;">S1p & Sp1n Laundry Shop</span>
          </td>
          <td class="num" style="color: #94a3b8;">(Separate Service)</td>
          <td class="num-bold" style="color: #1d4ed8;">₱15,161.00</td>
          <td class="num" style="color: #94a3b8;">-</td>
          <td style="text-align: center;"><span class="badge" style="background: #dbeafe; color: #1e40af;">Laundry</span></td>
          <td colspan="2" style="color: #334155;">Laundry services (Wash, Dry, Fold, Pressing, Detergents) are tracked directly in the POS database.</td>
        </tr>

        <tr class="row-total">
          <td colspan="2" style="font-size: 12px; font-weight: 900; text-transform: uppercase;">
            ⭐ TOTAL ACTUAL EARNED SALES (GROSS)
          </td>
          <td class="num-bold">₱12,203.00</td>
          <td class="num-bold" style="color: #047857; font-size: 13px;">₱27,867.00</td>
          <td class="num-bold" style="color: #047857;">+₱15,664.00</td>
          <td style="text-align: center;"><span class="badge" style="background: #059669; color: #ffffff;">₱27,867.00</span></td>
          <td colspan="2" style="color: #065f46; font-weight: 600;">Total actual customer revenue earned across all departments is ₱27,867.00.</td>
        </tr>

        <tr class="row-highlight">
          <td colspan="2" style="font-weight: bold; color: #7c3aed;">
            💵 Cash Drawer Starting Float (Cash-In)
          </td>
          <td class="num" style="color: #7c3aed;">-</td>
          <td class="num-bold" style="color: #7c3aed;">+₱2,000.00 / shift</td>
          <td class="num" style="color: #7c3aed;">-</td>
          <td style="text-align: center;"><span class="badge" style="background: #ede9fe; color: #6d28d9;">Float</span></td>
          <td colspan="2" style="color: #5b21b6;">Physical drawer cash count equals ₱27,867.00 (Sales) + ₱2,000.00 (Starting Float) = <b>₱29,867.00+</b>.</td>
        </tr>
      </tbody>
    </table>

